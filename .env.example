# Database
# Local Docker (docker-compose.yml) — use this for development.
# Port 5433 because Docker maps host:5433 → container:5432 to avoid
# conflict with any existing local Postgres on port 5432.
DATABASE_URL="postgresql://skyware:skyware_dev_password@localhost:5433/skyware_management"

# Auth
AUTH_SECRET="change-this-to-a-random-secret-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Object storage (S3-compatible)
STORAGE_BUCKET="skyware-attachments"
STORAGE_REGION="us-east-1"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Email (for future notifications)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# App settings
DEFAULT_LOCALE="en"
TZ="Asia/Jerusalem"
LOG_LEVEL="info"

# Feature flags (set to "true" to enable, default all false for safety)
# WARNING: Do NOT enable receipt_finalize until accountant has verified templates,
# numbering, VAT rate, and any applicable Tax Authority requirements.
RECEIPT_FINALIZE_ENABLED="false"
FINANCIAL_DOCUMENTS_MODULE="false"
AGENT_CONTROL_CENTER_MODULE="false"
