datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ===== Enums =====

enum DepartmentKey {
  global
  helpdesk
  it
  rnd
}

enum RoleKey {
  employee
  ceo
  cto
}

enum LanguagePref {
  en
  he
}

enum JobStatus {
  new
  assigned
  available
  taken
  working_on_it
  waiting_for_client
  waiting_for_admin
  done
  reviewed
  cancelled
}

enum JobPriority {
  low
  normal
  high
  urgent
}

enum JobSeverity {
  minor
  moderate
  major
  critical
}

enum JobSource {
  portal_manual
  email_manual
}

enum PaymentStatus {
  draft
  sent_to_client
  waiting_for_payment
  partially_paid
  paid
  cancelled
  overdue
}

enum PaymentMethod {
  bank_transfer
  bit
  cheque
  cash
  credit_card
  other
}

enum PaymentSourceType {
  monthly
  hourly_bank
  one_time
}

enum ReceiptDocumentType {
  invoice
  receipt
  tax_invoice
  tax_invoice_receipt
  credit_note
  proforma_invoice
}

enum ReceiptDocumentStatus {
  draft
  finalized
  cancelled
}

enum AllocationStatus {
  not_required
  pending
  issued
  failed
}

enum ClientStatus {
  active
  inactive
}

enum MonthlyBillingStatus {
  active
  paused
  cancelled
  none
}

enum HourlyBankStatus {
  active
  used_up
  none
}

enum TagScope {
  communication
  job
  both
}

enum AttachmentVisibility {
  public_in_org
  admin_only
}

enum CommunicationChannelKey {
  global
  helpdesk
  it
  rnd
}

enum SavedViewScope {
  jobs
  clients
  billing
  receipts
  communication
  statistics
}

enum TimerSource {
  manual_button
  idle_resume
}

enum EnvironmentNoteSection {
  network
  servers
  hosting
  contacts
  vendors
  security
  backup
  other
}

enum Currency {
  ILS
  USD
  EUR
}

enum NotificationKind {
  sla_breached
  job_assigned
  mention
  knowledge_review_requested
  knowledge_review_decided
  knowledge_freshness_due
  knowledge_link_broken
}

enum SavedViewVisibility {
  personal
  /// Any logged-in user can see team-shared views on the matching scope.
  team
}

/// ISO 3166-1 alpha-2 country code. Only IL is supported today; `OTHER`
/// (Postgres value `_other`) is a reserved placeholder so future country
/// profiles can be added without a schema migration. The Prisma client
/// surface uses `OTHER` because Prisma rejects leading underscores in enum
/// variants; the underlying DB value stays `_other` so it sorts last and is
/// obviously reserved. `lib/compliance/country.ts` throws when the active
/// CompanySettings row resolves to `OTHER`.
enum CountryCode {
  IL
  OTHER @map("_other")
}

// ===== Models =====

model Department {
  id       String        @id @default(uuid()) @db.Uuid
  key      DepartmentKey @unique
  nameEn   String        @map("name_en")
  nameHe   String        @map("name_he")
  isGlobal Boolean       @default(false) @map("is_global")

  users              User[]
  jobs               Job[]
  channels           CommunicationChannel[]
  recurringTemplates RecurringJobTemplate[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("departments")
}

model Role {
  id      String  @id @default(uuid()) @db.Uuid
  key     RoleKey @unique
  nameEn  String  @map("name_en")
  nameHe  String  @map("name_he")
  isAdmin Boolean @default(false) @map("is_admin")

  users User[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("roles")
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  username     String       @unique
  email        String       @unique
  displayName  String       @map("display_name")
  passwordHash String       @map("password_hash")
  departmentId String       @map("department_id") @db.Uuid
  roleId       String       @map("role_id") @db.Uuid
  isActive     Boolean      @default(true) @map("is_active")
  languagePref LanguagePref @default(en) @map("language_pref")
  timezone     String       @default("Asia/Jerusalem")
  lastLoginAt  DateTime?    @map("last_login_at")

  department Department @relation(fields: [departmentId], references: [id])
  role       Role       @relation(fields: [roleId], references: [id])

  assignedJobs               Job[]                      @relation("AssignedJobs")
  createdJobs                Job[]                      @relation("CreatedJobs")
  statusEvents               JobStatusEvent[]
  submittedReports           WorkReport[]               @relation("SubmittedReports")
  approvedReports            WorkReport[]               @relation("ApprovedReports")
  timeSessions               TimeSession[]
  posts                      CommunicationPost[]
  replies                    CommunicationReply[]
  savedViewsOwned            SavedView[]                @relation("SavedViewOwner")
  savedViewsCreated          SavedView[]                @relation("SavedViewCreator")
  auditLogs                  AuditLog[]
  environmentNotes           ClientEnvironmentNote[]
  createdClients             Client[]
  createdPayments            Payment[]
  finalizedReceipts          ReceiptDocument[]
  uploadedAttachments        Attachment[]
  bankUsagesRecorded         HourlyBankUsage[]
  updatedFeatureFlags        FeatureFlag[]
  notifications              Notification[]
  slaDefaults                SlaDefaults[]
  updatedCompanySettings     CompanySettings[]          @relation("UpdatedCompanySettings")
  recurringTemplatesCreated  RecurringJobTemplate[]     @relation("RecurringCreatedBy")
  recurringTemplatesUpdated  RecurringJobTemplate[]     @relation("RecurringUpdatedBy")
  recurringTemplatesAssigned RecurringJobTemplate[]     @relation("RecurringDefaultAssignee")
  knowledgeAuthored          KnowledgeArticle[]         @relation("KnowledgeAuthor")
  knowledgeEdited            KnowledgeArticle[]         @relation("KnowledgeLastEditor")
  knowledgeVerified          KnowledgeArticle[]         @relation("KnowledgeArticleVerifier")
  knowledgeReviewed          KnowledgeArticle[]         @relation("KnowledgeArticleReviewer")
  knowledgeRevisionsAuthored KnowledgeArticleRevision[] @relation("KnowledgeArticleRevisionAuthor")
  knowledgeReviewsConducted  KnowledgeArticleReview[]   @relation("KnowledgeArticleReviewReviewer")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Job {
  id                  String      @id @default(uuid()) @db.Uuid
  publicNumber        String      @unique @map("public_number")
  clientId            String?     @map("client_id") @db.Uuid
  departmentId        String      @map("department_id") @db.Uuid
  title               String
  description         String?     @db.Text
  assignedEmployeeId  String?     @map("assigned_employee_id") @db.Uuid
  createdByUserId     String      @map("created_by_user_id") @db.Uuid
  status              JobStatus   @default(new)
  priority            JobPriority @default(normal)
  severity            JobSeverity @default(moderate)
  slaTargetMinutes    Int         @map("sla_target_minutes")
  assignedTimestamp   DateTime?   @map("assigned_timestamp")
  takenTimestamp      DateTime?   @map("taken_timestamp")
  startedTimestamp    DateTime?   @map("started_timestamp")
  completedTimestamp  DateTime?   @map("completed_timestamp")
  reviewedTimestamp   DateTime?   @map("reviewed_timestamp")
  cancelledTimestamp  DateTime?   @map("cancelled_timestamp")
  firstResponseAt     DateTime?   @map("first_response_at")
  timeSpentMinutes    Int         @default(0) @map("time_spent_minutes")
  adminNote           String?     @map("admin_note") @db.Text
  isBillable          Boolean     @default(true) @map("is_billable")
  linkedPaymentId     String?     @map("linked_payment_id") @db.Uuid
  source              JobSource   @default(portal_manual)
  recurringTemplateId String?     @map("recurring_template_id") @db.Uuid

  client            Client?               @relation(fields: [clientId], references: [id])
  department        Department            @relation(fields: [departmentId], references: [id])
  assignedEmployee  User?                 @relation("AssignedJobs", fields: [assignedEmployeeId], references: [id])
  createdBy         User                  @relation("CreatedJobs", fields: [createdByUserId], references: [id])
  linkedPayment     Payment?              @relation("JobLinkedPayment", fields: [linkedPaymentId], references: [id])
  recurringTemplate RecurringJobTemplate? @relation("RecurringSourceTemplate", fields: [recurringTemplateId], references: [id])

  statusEvents             JobStatusEvent[]
  workReport               WorkReport?
  timeSessions             TimeSession[]
  hourlyBankUsages         HourlyBankUsage[]
  oneTimeCharge            OneTimeJobCharge?
  tags                     JobTag[]
  attachments              JobAttachment[]
  relatedPosts             CommunicationPost[]
  relatedKnowledgeArticles KnowledgeArticle[]  @relation("KnowledgeArticleSourceJob")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([departmentId, status])
  @@index([assignedEmployeeId, status])
  @@index([clientId])
  @@index([status, createdAt(sort: Desc)])
  @@index([priority, status])
  @@index([severity, status])
  @@index([recurringTemplateId])
  @@map("jobs")
}

model JobStatusEvent {
  id                    String     @id @default(uuid()) @db.Uuid
  jobId                 String     @map("job_id") @db.Uuid
  fromStatus            JobStatus? @map("from_status")
  toStatus              JobStatus  @map("to_status")
  changedByUserId       String     @map("changed_by_user_id") @db.Uuid
  changedAt             DateTime   @default(now()) @map("changed_at")
  note                  String?    @db.Text
  timeSpentDeltaMinutes Int        @default(0) @map("time_spent_delta_minutes")
  reopened              Boolean    @default(false)

  job       Job  @relation(fields: [jobId], references: [id])
  changedBy User @relation(fields: [changedByUserId], references: [id])

  @@index([jobId, changedAt(sort: Desc)])
  @@index([changedByUserId, changedAt(sort: Desc)])
  @@map("job_status_events")
}

model WorkReport {
  id               String    @id @default(uuid()) @db.Uuid
  jobId            String    @unique @map("job_id") @db.Uuid
  summary          String    @db.Text
  totalTimeMinutes Int       @map("total_time_minutes")
  billable         Boolean   @default(true)
  submittedById    String    @map("submitted_by_user_id") @db.Uuid
  submittedAt      DateTime  @default(now()) @map("submitted_at")
  approvedById     String?   @map("approved_by_user_id") @db.Uuid
  approvedAt       DateTime? @map("approved_at")

  job         Job   @relation(fields: [jobId], references: [id])
  submittedBy User  @relation("SubmittedReports", fields: [submittedById], references: [id])
  approvedBy  User? @relation("ApprovedReports", fields: [approvedById], references: [id])

  relatedKnowledgeArticles KnowledgeArticle[] @relation("KnowledgeArticleSourceWorkReport")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("work_reports")
}

model TimeSession {
  id                 String      @id @default(uuid()) @db.Uuid
  userId             String      @map("user_id") @db.Uuid
  jobId              String      @map("job_id") @db.Uuid
  startedAt          DateTime    @map("started_at")
  pausedAt           DateTime?   @map("paused_at")
  resumedAt          DateTime?   @map("resumed_at")
  endedAt            DateTime?   @map("ended_at")
  accumulatedMinutes Int         @default(0) @map("accumulated_minutes")
  source             TimerSource @default(manual_button)
  idleWarnedAt       DateTime?   @map("idle_warned_at")

  user User @relation(fields: [userId], references: [id])
  job  Job  @relation(fields: [jobId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([jobId, startedAt(sort: Desc)])
  @@map("time_sessions")
}

model Tag {
  id       String   @id @default(uuid()) @db.Uuid
  key      String   @unique
  labelEn  String   @map("label_en")
  labelHe  String   @map("label_he")
  scope    TagScope @default(communication)
  isSystem Boolean  @default(false) @map("is_system")
  colorHex String?  @map("color_hex")

  jobTags              JobTag[]
  postTags             PostTag[]
  knowledgeArticleTags KnowledgeArticleTag[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tags")
}

model JobTag {
  jobId String @map("job_id") @db.Uuid
  tagId String @map("tag_id") @db.Uuid

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([jobId, tagId])
  @@map("job_tags")
}

model PostTag {
  postId String @map("post_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid

  post CommunicationPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag               @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tags")
}

model Client {
  id              String       @id @default(uuid()) @db.Uuid
  companyName     String       @map("company_name")
  contactPerson   String?      @map("contact_person")
  email           String?
  phone           String?
  address         String?      @db.Text
  israeliTaxId    String?      @map("israeli_tax_id")
  status          ClientStatus @default(active)
  notes           String?      @db.Text
  createdByUserId String       @map("created_by_user_id") @db.Uuid

  createdBy User @relation(fields: [createdByUserId], references: [id])

  billingAccount     BillingAccount?
  jobs               Job[]
  payments           Payment[]
  receipts           ReceiptDocument[]
  environmentNotes   ClientEnvironmentNote[]
  relatedPosts       CommunicationPost[]
  recurringTemplates RecurringJobTemplate[]
  knowledgeArticles  KnowledgeArticle[]      @relation("ClientKnowledge")
  healthSnapshots    ClientHealthSnapshot[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([companyName])
  @@index([status])
  @@map("clients")
}

model BillingAccount {
  id              String   @id @default(uuid()) @db.Uuid
  clientId        String   @unique @map("client_id") @db.Uuid
  defaultCurrency Currency @default(ILS) @map("default_currency")
  notes           String?  @db.Text

  client              Client               @relation(fields: [clientId], references: [id])
  monthlyBillingItems MonthlyBillingItem[]
  hourlyBanks         HourlyBank[]
  oneTimeCharges      OneTimeJobCharge[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("billing_accounts")
}

model ClientEnvironmentNote {
  id                 String                 @id @default(uuid()) @db.Uuid
  clientId           String                 @map("client_id") @db.Uuid
  section            EnvironmentNoteSection
  content            String                 @db.Text
  lastEditedByUserId String                 @map("last_edited_by_user_id") @db.Uuid
  lastEditedAt       DateTime               @map("last_edited_at")

  client       Client @relation(fields: [clientId], references: [id])
  lastEditedBy User   @relation(fields: [lastEditedByUserId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([clientId, section])
  @@map("client_environment_notes")
}

model MonthlyBillingItem {
  id                     String               @id @default(uuid()) @db.Uuid
  billingAccountId       String               @map("billing_account_id") @db.Uuid
  serviceName            String               @map("service_name")
  priceAmountPlaceholder Int?                 @map("price_amount_placeholder")
  currency               Currency             @default(ILS)
  billingCycle           String               @default("monthly") @map("billing_cycle")
  startDate              DateTime             @map("start_date") @db.Date
  endDate                DateTime?            @map("end_date") @db.Date
  status                 MonthlyBillingStatus @default(active)
  lastBilledPeriod       String?              @map("last_billed_period")
  nextDueDate            DateTime?            @map("next_due_date") @db.Date

  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id])
  payments       Payment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([billingAccountId])
  @@index([status])
  @@index([nextDueDate])
  @@map("monthly_billing_items")
}

model HourlyBank {
  id                         String           @id @default(uuid()) @db.Uuid
  billingAccountId           String           @map("billing_account_id") @db.Uuid
  totalHoursPurchasedMinutes Int?             @map("total_hours_purchased_minutes")
  pricePerHourPlaceholder    Int?             @map("price_per_hour_placeholder")
  totalPaymentPlaceholder    Int?             @map("total_payment_placeholder")
  currency                   Currency         @default(ILS)
  purchaseDate               DateTime         @map("purchase_date") @db.Date
  expiryDate                 DateTime?        @map("expiry_date") @db.Date
  status                     HourlyBankStatus @default(active)
  alertThresholdPercent      Int              @default(25) @map("alert_threshold_percent")

  billingAccount BillingAccount    @relation(fields: [billingAccountId], references: [id])
  usages         HourlyBankUsage[]
  payments       Payment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([billingAccountId])
  @@index([status])
  @@map("hourly_banks")
}

model HourlyBankUsage {
  id               String   @id @default(uuid()) @db.Uuid
  hourlyBankId     String   @map("hourly_bank_id") @db.Uuid
  jobId            String   @map("job_id") @db.Uuid
  minutesUsed      Int      @map("minutes_used")
  usedAt           DateTime @default(now()) @map("used_at")
  recordedByUserId String   @map("recorded_by_user_id") @db.Uuid
  note             String?  @db.Text

  hourlyBank HourlyBank @relation(fields: [hourlyBankId], references: [id])
  job        Job        @relation(fields: [jobId], references: [id])
  recordedBy User       @relation(fields: [recordedByUserId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([hourlyBankId, usedAt(sort: Desc)])
  @@index([jobId])
  @@map("hourly_bank_usages")
}

model OneTimeJobCharge {
  id                     String    @id @default(uuid()) @db.Uuid
  billingAccountId       String    @map("billing_account_id") @db.Uuid
  jobId                  String    @unique @map("job_id") @db.Uuid
  jobNameSnapshot        String    @map("job_name_snapshot")
  priceAmountPlaceholder Int?      @map("price_amount_placeholder")
  currency               Currency  @default(ILS)
  paymentId              String?   @map("payment_id") @db.Uuid
  dateCreated            DateTime  @default(now()) @map("date_created")
  datePaid               DateTime? @map("date_paid")

  billingAccount BillingAccount @relation(fields: [billingAccountId], references: [id])
  job            Job            @relation(fields: [jobId], references: [id])
  payment        Payment?       @relation("OtcPayment", fields: [paymentId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("one_time_job_charges")
}

model Payment {
  id                   String            @id @default(uuid()) @db.Uuid
  clientId             String            @map("client_id") @db.Uuid
  sourceType           PaymentSourceType @map("source_type")
  sourceMonthlyId      String?           @map("source_monthly_id") @db.Uuid
  sourceHourlyId       String?           @map("source_hourly_id") @db.Uuid
  amountPlaceholder    Int?              @map("amount_placeholder")
  /// VAT split fields, added in migration 20260525000200. All nullable; the
  /// legacy `amountPlaceholder` (now treated as the gross total when the
  /// split is absent) stays for existing rows. New writes should populate
  /// `amountBeforeVat` + `vatAmount` + `totalAmount` + `vatRateBasisPoints`.
  amountBeforeVat      Int?              @map("amount_before_vat")
  vatAmount            Int?              @map("vat_amount")
  totalAmount          Int?              @map("total_amount")
  /// VAT rate stored as basis points (e.g. 1800 = 18.00%). Snapshot at
  /// payment-issue time so historical rates survive a profile change.
  vatRateBasisPoints   Int?              @map("vat_rate_basis_points")
  /// Rate from `currency` to ILS at issue moment. Symmetry with
  /// ReceiptDocument.exchangeRate. Nullable for ILS rows.
  currencyExchangeRate Decimal?          @map("currency_exchange_rate") @db.Decimal(18, 6)
  currency             Currency          @default(ILS)
  issuedDate           DateTime          @map("issued_date") @db.Date
  dueDate              DateTime?         @map("due_date") @db.Date
  paidDate             DateTime?         @map("paid_date") @db.Date
  status               PaymentStatus     @default(draft)
  method               PaymentMethod?
  reference            String?
  linkedReceiptId      String?           @map("linked_receipt_id") @db.Uuid
  notes                String?           @db.Text
  createdByUserId      String            @map("created_by_user_id") @db.Uuid

  client        Client              @relation(fields: [clientId], references: [id])
  sourceMonthly MonthlyBillingItem? @relation(fields: [sourceMonthlyId], references: [id])
  sourceHourly  HourlyBank?         @relation(fields: [sourceHourlyId], references: [id])
  createdBy     User                @relation(fields: [createdByUserId], references: [id])
  linkedReceipt ReceiptDocument?    @relation("PaymentReceipt", fields: [linkedReceiptId], references: [id])

  linkedJobs     Job[]              @relation("JobLinkedPayment")
  oneTimeCharges OneTimeJobCharge[] @relation("OtcPayment")
  /// Back-relation for ReceiptDocument.payment (FK on receipt_documents.payment_id,
  /// added in migration 20260525000300). One payment can have multiple receipts
  /// (e.g. invoice plus separate receipt plus credit note).
  receipts       ReceiptDocument[]  @relation("ReceiptPayment")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([clientId, status])
  @@index([status, dueDate])
  @@index([paidDate])
  @@map("payments")
}

model ReceiptDocument {
  id                    String                @id @default(uuid()) @db.Uuid
  type                  ReceiptDocumentType
  clientId              String                @map("client_id") @db.Uuid
  paymentId             String?               @map("payment_id") @db.Uuid
  documentNumber        Int?                  @map("document_number")
  documentNumberYear    Int?                  @map("document_number_year")
  status                ReceiptDocumentStatus @default(draft)
  issueDate             DateTime              @map("issue_date") @db.Date
  paymentDate           DateTime?             @map("payment_date") @db.Date
  descriptionLines      Json                  @default("[]") @map("description_lines")
  amountBeforeVat       Int?                  @map("amount_before_vat")
  vatRateBasisPoints    Int                   @default(1800) @map("vat_rate_basis_points")
  vatAmount             Int?                  @map("vat_amount")
  totalAmount           Int?                  @map("total_amount")
  paymentMethod         PaymentMethod?        @map("payment_method")
  reference             String?
  currency              Currency              @default(ILS)
  notes                 String?               @db.Text
  language              String                @default("he")
  allocationNumber      String?               @map("allocation_number")
  allocationStatus      AllocationStatus      @default(not_required) @map("allocation_status")
  allocationObtainedAt  DateTime?             @map("allocation_obtained_at")
  finalizedAt           DateTime?             @map("finalized_at")
  finalizedByUserId     String?               @map("finalized_by_user_id") @db.Uuid
  /// Rate from `currency` to ILS at finalize moment. Required when finalized
  /// and currency is not ILS. Enforced by check constraint in migration
  /// 20260524000600_receipt_invariants.
  exchangeRate          Decimal?              @map("exchange_rate") @db.Decimal(18, 6)
  /// On a credit-note row, points to the original receipt being credited.
  creditedReceiptId     String?               @map("credited_receipt_id") @db.Uuid
  /// Snapshot of CompanySettings + line data captured at FINALIZE time
  /// so future CompanySettings edits do not rewrite historical documents.
  /// JSON shape mirrors `lib/pdf/snapshot.ts` `ReceiptSnapshot` type.
  headerSnapshot        Json?                 @map("header_snapshot")
  /// Cached rendered PDF object key (S3-compatible storage). Drafts are
  /// re-rendered fresh on each request; finalized rows render once and
  /// reuse this key.
  cachedPdfAttachmentId String?               @map("cached_pdf_attachment_id") @db.Uuid

  client              Client            @relation(fields: [clientId], references: [id])
  finalizedBy         User?             @relation(fields: [finalizedByUserId], references: [id])
  creditedReceipt     ReceiptDocument?  @relation("ReceiptCredits", fields: [creditedReceiptId], references: [id])
  creditedBy          ReceiptDocument[] @relation("ReceiptCredits")
  /// Optional payment this receipt was issued for. FK enforced at the DB
  /// level by migration 20260525000300. `ON DELETE SET NULL` so deleting a
  /// payment does not cascade into receipts.
  payment             Payment?          @relation("ReceiptPayment", fields: [paymentId], references: [id], onDelete: SetNull)
  cachedPdfAttachment Attachment?       @relation("ReceiptCachedPdf", fields: [cachedPdfAttachmentId], references: [id])

  sourcePayments Payment[] @relation("PaymentReceipt")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([type, documentNumberYear, documentNumber], name: "unique_document_number")
  @@index([clientId])
  @@index([status])
  @@map("receipt_documents")
}

model ReceiptDocumentSequence {
  id         String              @id @default(uuid()) @db.Uuid
  type       ReceiptDocumentType
  year       Int
  nextNumber Int                 @default(1) @map("next_number")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([type, year])
  @@map("receipt_document_sequences")
}

model CommunicationChannel {
  id           String                  @id @default(uuid()) @db.Uuid
  key          CommunicationChannelKey @unique
  departmentId String?                 @map("department_id") @db.Uuid
  nameEn       String                  @map("name_en")
  nameHe       String                  @map("name_he")
  description  String?                 @db.Text

  department Department?         @relation(fields: [departmentId], references: [id])
  posts      CommunicationPost[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("communication_channels")
}

model CommunicationPost {
  id              String  @id @default(uuid()) @db.Uuid
  channelId       String  @map("channel_id") @db.Uuid
  authorId        String  @map("author_id") @db.Uuid
  title           String
  body            String  @db.Text
  relatedJobId    String? @map("related_job_id") @db.Uuid
  relatedClientId String? @map("related_client_id") @db.Uuid
  pinned          Boolean @default(false)
  resolved        Boolean @default(false)

  channel       CommunicationChannel @relation(fields: [channelId], references: [id])
  author        User                 @relation(fields: [authorId], references: [id])
  relatedJob    Job?                 @relation(fields: [relatedJobId], references: [id])
  relatedClient Client?              @relation(fields: [relatedClientId], references: [id])

  replies     CommunicationReply[]
  tags        PostTag[]
  attachments PostAttachment[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([channelId, createdAt(sort: Desc)])
  @@index([authorId])
  @@map("communication_posts")
}

model CommunicationReply {
  id       String @id @default(uuid()) @db.Uuid
  postId   String @map("post_id") @db.Uuid
  authorId String @map("author_id") @db.Uuid
  body     String @db.Text

  post   CommunicationPost @relation(fields: [postId], references: [id])
  author User              @relation(fields: [authorId], references: [id])

  attachments ReplyAttachment[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([postId, createdAt])
  @@map("communication_replies")
}

model SavedView {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String?             @map("user_id") @db.Uuid
  scope       SavedViewScope
  name        String
  filterJson  Json                @map("filter_json")
  isTeam      Boolean             @default(false) @map("is_team")
  visibility  SavedViewVisibility @default(personal)
  isDefault   Boolean             @default(false) @map("is_default")
  createdById String              @map("created_by_user_id") @db.Uuid

  owner     User? @relation("SavedViewOwner", fields: [userId], references: [id])
  createdBy User  @relation("SavedViewCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Default-per-scope guarantees:
  //  - Personal default: unique per (user_id, scope) when visibility=personal.
  //  - Team default: unique per (scope) when visibility=team.
  // Enforced by partial unique indexes in migration
  // `20260524001300_saved_view_visibility`.
  @@index([userId, scope])
  @@index([isTeam, scope])
  @@index([visibility, scope])
  @@map("saved_views")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  diffJson    Json?    @map("diff_json")
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model Attachment {
  id               String               @id @default(uuid()) @db.Uuid
  storageKey       String               @map("storage_key")
  fileName         String               @map("file_name")
  mimeType         String               @map("mime_type")
  byteSize         Int                  @map("byte_size")
  uploadedByUserId String               @map("uploaded_by_user_id") @db.Uuid
  visibility       AttachmentVisibility @default(public_in_org)

  uploadedBy       User              @relation(fields: [uploadedByUserId], references: [id])
  jobLinks         JobAttachment[]
  postLinks        PostAttachment[]
  replyLinks       ReplyAttachment[]
  receiptCachedFor ReceiptDocument[] @relation("ReceiptCachedPdf")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("attachments")
}

model JobAttachment {
  jobId        String @map("job_id") @db.Uuid
  attachmentId String @map("attachment_id") @db.Uuid

  job        Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  attachment Attachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@id([jobId, attachmentId])
  @@map("job_attachments")
}

model PostAttachment {
  postId       String @map("post_id") @db.Uuid
  attachmentId String @map("attachment_id") @db.Uuid

  post       CommunicationPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  attachment Attachment        @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@id([postId, attachmentId])
  @@map("post_attachments")
}

model ReplyAttachment {
  replyId      String @map("reply_id") @db.Uuid
  attachmentId String @map("attachment_id") @db.Uuid

  reply      CommunicationReply @relation(fields: [replyId], references: [id], onDelete: Cascade)
  attachment Attachment         @relation(fields: [attachmentId], references: [id], onDelete: Cascade)

  @@id([replyId, attachmentId])
  @@map("reply_attachments")
}

model FeatureFlag {
  id              String  @id @default(uuid()) @db.Uuid
  key             String  @unique
  enabled         Boolean @default(false)
  description     String? @db.Text
  updatedByUserId String? @map("updated_by_user_id") @db.Uuid

  updatedBy User? @relation(fields: [updatedByUserId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  kind      NotificationKind
  /// Free-form payload. Shape varies by `kind`; consumers narrow by `kind`.
  /// Examples:
  ///   sla_breached  -> { jobId: string, publicNumber: string, breachMinutes: number }
  ///   job_assigned  -> { jobId: string, publicNumber: string, title: string }
  ///   mention       -> { postId: string, replyId?: string, channelKey: string }
  payload   Json
  /// Optional deep link the UI navigates to when the row is clicked.
  link      String?
  seenAt    DateTime?        @map("seen_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Unread-first per user (NULL sorts highest with Desc by default in Postgres,
  // but we expose this index to support `seenAt IS NULL` filtering quickly).
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, seenAt])
  @@map("notifications")
}

model SlaDefaults {
  id              String      @id @default(uuid()) @db.Uuid
  priority        JobPriority @unique
  /// Minutes from `assigned_timestamp` to when the job is considered breached.
  targetMinutes   Int         @map("target_minutes")
  updatedByUserId String?     @map("updated_by_user_id") @db.Uuid
  updatedBy       User?       @relation(fields: [updatedByUserId], references: [id])
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  @@map("sla_defaults")
}

model CompanySettings {
  /// Application enforces a single row by always using this id; backed by a
  /// CHECK constraint in migration 20260524000800_company_settings_singleton.
  id                    String      @id @default("00000000-0000-0000-0000-000000000001") @db.Uuid
  legalNameEn           String?     @map("legal_name_en")
  legalNameHe           String?     @map("legal_name_he")
  companyNumber         String?     @map("company_number")
  vatNumber             String?     @map("vat_number")
  timezone              String      @default("Asia/Jerusalem")
  /// VAT rate stored as basis points (e.g. 1800 = 18.00%).
  defaultVatBasisPoints Int         @default(1800) @map("default_vat_basis_points")
  defaultCurrency       Currency    @default(ILS) @map("default_currency")
  email                 String?
  phone                 String?
  addressLine1          String?     @map("address_line1")
  addressLine2          String?     @map("address_line2")
  city                  String?
  postalCode            String?     @map("postal_code")
  /// Country profile selector. Drives the IL VAT rules in
  /// `lib/compliance/country.ts`. Default IL; `_OTHER` is reserved.
  country               CountryCode @default(IL)
  websiteUrl            String?     @map("website_url")
  receiptFooterEn       String?     @map("receipt_footer_en") @db.Text
  receiptFooterHe       String?     @map("receipt_footer_he") @db.Text
  updatedByUserId       String?     @map("updated_by_user_id") @db.Uuid

  updatedBy User? @relation("UpdatedCompanySettings", fields: [updatedByUserId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("company_settings")
}

enum RecurringCadence {
  daily
  weekly
  biweekly
  monthly
  quarterly
}

enum RecurringTemplateStatus {
  active
  paused
}

model RecurringJobTemplate {
  id                String                  @id @default(uuid()) @db.Uuid
  /// Optional friendly name; if null, derived from `titleTemplate`.
  name              String?
  /// Job-creation template fields. Same shape as a manual job create form.
  titleTemplate     String                  @map("title_template")
  description       String?                 @db.Text
  departmentId      String                  @map("department_id") @db.Uuid
  clientId          String?                 @map("client_id") @db.Uuid
  priority          JobPriority             @default(normal)
  severity          JobSeverity             @default(moderate)
  defaultAssigneeId String?                 @map("default_assignee_id") @db.Uuid
  cadence           RecurringCadence
  /// Cron-style anchor: minute-of-day 0..1439 for daily, day-of-week 0..6 for
  /// weekly/biweekly (0 = Sunday), day-of-month 1..28 for monthly/quarterly.
  /// Stored as JSON so cadences can extend without a migration.
  anchor            Json
  /// Asia/Jerusalem by default. Generation respects this zone.
  timezone          String                  @default("Asia/Jerusalem")
  /// Next time the writer should consider this template.
  nextRunAt         DateTime                @map("next_run_at")
  lastGeneratedAt   DateTime?               @map("last_generated_at")
  /// Total number of jobs this template has spawned (cumulative).
  generatedCount    Int                     @default(0) @map("generated_count")
  status            RecurringTemplateStatus @default(active)
  createdByUserId   String                  @map("created_by_user_id") @db.Uuid
  updatedByUserId   String?                 @map("updated_by_user_id") @db.Uuid

  department      Department @relation(fields: [departmentId], references: [id])
  client          Client?    @relation(fields: [clientId], references: [id])
  defaultAssignee User?      @relation("RecurringDefaultAssignee", fields: [defaultAssigneeId], references: [id])
  createdBy       User       @relation("RecurringCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy       User?      @relation("RecurringUpdatedBy", fields: [updatedByUserId], references: [id])
  generatedJobs   Job[]      @relation("RecurringSourceTemplate")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, nextRunAt])
  @@index([departmentId])
  @@index([clientId])
  @@map("recurring_job_templates")
}

enum KnowledgeArticleStatus {
  draft
  ai_structured
  pending_review
  approved
  published
  archived
}

enum KnowledgeArticleType {
  internal_task_lesson
  external_reference
  how_to_guide
  troubleshooting_note
  architecture_decision
  process_policy_note
}

enum KnowledgeReliabilityTier {
  verified
  validated
  single_source
  anecdotal
}

enum KnowledgeArticleReviewStatus {
  pending
  approved
  changes_requested
  rejected
}

enum KnowledgeArticleReferenceKind {
  related
  supersedes
  superseded_by
  see_also
}

enum KnowledgeArticleVisibility {
  /// Visible to everyone with portal access.
  internal
  /// Visible only to admins.
  admin_only
}

model KnowledgeArticle {
  id                 String                     @id @default(uuid()) @db.Uuid
  /// URL-safe identifier; unique. Generated from title at create time.
  slug               String                     @unique
  title              String
  /// Markdown body. Render via existing markdown helper if any; else plain text.
  body               String                     @db.Text
  /// Optional one-line summary used in lists. Required by application layer for
  /// kind = external_reference; nullable at the DB layer so legacy rows stay valid.
  summary            String?                    @db.Text
  status             KnowledgeArticleStatus     @default(draft)
  visibility         KnowledgeArticleVisibility @default(internal)
  /// Soft-delete: archived articles drop out of search and list views.
  /// Hard delete via API is admin-only and audited.
  authorUserId       String                     @map("author_user_id") @db.Uuid
  lastEditedByUserId String?                    @map("last_edited_by_user_id") @db.Uuid
  publishedAt        DateTime?                  @map("published_at")
  /// Optional related client; gives a "this article is about client X" hint.
  relatedClientId    String?                    @map("related_client_id") @db.Uuid

  /// Knowledge V1: classification, source linkage, external metadata, AI snapshots,
  /// version pointer, reviewer/verifier tracking, reader-facing context.
  kind                 KnowledgeArticleType     @default(how_to_guide)
  sourceJobId          String?                  @map("source_job_id") @db.Uuid
  sourceWorkReportId   String?                  @map("source_work_report_id") @db.Uuid
  externalSource       String?                  @map("external_source")
  externalUrl          String?                  @map("external_url") @db.Text
  externalUrlHash      String?                  @map("external_url_hash")
  lastVerifiedAt       DateTime?                @map("last_verified_at")
  lastVerifiedByUserId String?                  @map("last_verified_by_user_id") @db.Uuid
  reliabilityTier      KnowledgeReliabilityTier @default(single_source) @map("reliability_tier")
  /// 0..100 confidence score. Range guarded by CHECK constraint.
  confidenceScore      Int?                     @map("confidence_score")
  /// JSONB snapshot of the LLM-structured output captured at AI structuring time.
  /// Immutable after capture; further editing goes into revisions.
  aiStructuredSnapshot Json?                    @map("ai_structured_snapshot")
  /// Plain-text snapshot of the original worker writeup before AI structuring.
  rawInputSnapshot     String?                  @map("raw_input_snapshot") @db.Text
  /// Monotonically incrementing revision counter. History lives in
  /// KnowledgeArticleRevision; this column is the head pointer.
  currentVersion       Int                      @default(1) @map("current_version")
  lastReviewedAt       DateTime?                @map("last_reviewed_at")
  reviewerUserId       String?                  @map("reviewer_user_id") @db.Uuid
  /// 1-3 sentence "why this article matters". Optional.
  whyItMatters         String?                  @map("why_it_matters") @db.Text

  author           User                        @relation("KnowledgeAuthor", fields: [authorUserId], references: [id])
  lastEditedBy     User?                       @relation("KnowledgeLastEditor", fields: [lastEditedByUserId], references: [id])
  relatedClient    Client?                     @relation("ClientKnowledge", fields: [relatedClientId], references: [id])
  sourceJob        Job?                        @relation("KnowledgeArticleSourceJob", fields: [sourceJobId], references: [id], onDelete: SetNull)
  sourceWorkReport WorkReport?                 @relation("KnowledgeArticleSourceWorkReport", fields: [sourceWorkReportId], references: [id], onDelete: SetNull)
  lastVerifiedBy   User?                       @relation("KnowledgeArticleVerifier", fields: [lastVerifiedByUserId], references: [id], onDelete: SetNull)
  reviewer         User?                       @relation("KnowledgeArticleReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull)
  tags             KnowledgeArticleTag[]
  revisions        KnowledgeArticleRevision[]  @relation("KnowledgeArticleRevisions")
  reviews          KnowledgeArticleReview[]    @relation("KnowledgeArticleReviews")
  references       KnowledgeArticleReference[] @relation("KnowledgeArticleRefs")
  referencedBy     KnowledgeArticleReference[] @relation("KnowledgeArticleReferencedBy")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status, updatedAt(sort: Desc)])
  @@index([relatedClientId])
  @@map("knowledge_articles")
}

model KnowledgeArticleRevision {
  id           String   @id @default(uuid()) @db.Uuid
  articleId    String   @map("article_id") @db.Uuid
  version      Int
  title        String
  body         String   @db.Text
  summary      String?  @db.Text
  whyItMatters String?  @map("why_it_matters") @db.Text
  authorUserId String   @map("author_user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  article KnowledgeArticle @relation("KnowledgeArticleRevisions", fields: [articleId], references: [id], onDelete: Cascade)
  author  User             @relation("KnowledgeArticleRevisionAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@unique([articleId, version])
  @@index([articleId, createdAt(sort: Desc)])
  @@map("knowledge_article_revisions")
}

model KnowledgeArticleReview {
  id             String                       @id @default(uuid()) @db.Uuid
  articleId      String                       @map("article_id") @db.Uuid
  reviewerUserId String                       @map("reviewer_user_id") @db.Uuid
  status         KnowledgeArticleReviewStatus @default(pending)
  comment        String?                      @db.Text
  decidedAt      DateTime?                    @map("decided_at")
  cycleNumber    Int                          @default(1) @map("cycle_number")
  createdAt      DateTime                     @default(now()) @map("created_at")

  article  KnowledgeArticle @relation("KnowledgeArticleReviews", fields: [articleId], references: [id], onDelete: Cascade)
  reviewer User             @relation("KnowledgeArticleReviewReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)

  @@index([articleId, createdAt(sort: Desc)])
  @@index([reviewerUserId, status])
  @@map("knowledge_article_reviews")
}

model KnowledgeArticleReference {
  id                  String                        @id @default(uuid()) @db.Uuid
  articleId           String                        @map("article_id") @db.Uuid
  referencedArticleId String                        @map("referenced_article_id") @db.Uuid
  kind                KnowledgeArticleReferenceKind @default(related)
  createdAt           DateTime                      @default(now()) @map("created_at")

  article           KnowledgeArticle @relation("KnowledgeArticleRefs", fields: [articleId], references: [id], onDelete: Cascade)
  referencedArticle KnowledgeArticle @relation("KnowledgeArticleReferencedBy", fields: [referencedArticleId], references: [id], onDelete: Cascade)

  @@unique([articleId, referencedArticleId, kind])
  @@index([referencedArticleId])
  @@map("knowledge_article_references")
}

/// Reuses the existing Tag table. A tag with scope `communication`, `job`,
/// or `both` may attach to articles; this join expresses that link.
model KnowledgeArticleTag {
  articleId String @map("article_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  article KnowledgeArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag              @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@map("knowledge_article_tags")
}

model ClientHealthSnapshot {
  id                    String   @id @default(uuid()) @db.Uuid
  clientId              String   @map("client_id") @db.Uuid
  /// ISO week start (Monday 00:00 in client timezone or Asia/Jerusalem fallback).
  periodStart           DateTime @map("period_start") @db.Date
  periodEnd             DateTime @map("period_end") @db.Date
  openJobs              Int      @map("open_jobs")
  delayedJobs           Int      @map("delayed_jobs")
  /// Hours reported on this client's jobs that closed within the period.
  hoursConsumed         Decimal  @map("hours_consumed") @db.Decimal(10, 2)
  /// Sum of unpaid + overdue payment amounts (minor units) AS OF the snapshot time.
  outstandingMinorUnits Int      @map("outstanding_minor_units")
  /// Average projected months remaining on the client's active hourly banks.
  /// Null if the client has no active hourly banks.
  avgProjectedMonths    Decimal? @map("avg_projected_months") @db.Decimal(8, 2)
  /// Free-form JSON for forward-compatible metrics we add later.
  extra                 Json     @default("{}")
  generatedAt           DateTime @default(now()) @map("generated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, periodStart], name: "client_period_unique")
  @@index([clientId, periodStart(sort: Desc)])
  @@map("client_health_snapshots")
}
