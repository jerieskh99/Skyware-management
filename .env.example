# Database
# Local Docker (docker-compose.yml) — use this for development.
# Port 5433 because Docker maps host:5433 → container:5432 to avoid
# conflict with any existing local Postgres on port 5432.
DATABASE_URL="postgresql://skyware:skyware_dev_password@localhost:5433/skyware_management"

# Auth
AUTH_SECRET="change-this-to-a-random-secret-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Object storage (S3-compatible)
STORAGE_BUCKET="skyware-attachments"
STORAGE_REGION="us-east-1"
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""

# Email (for future notifications)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# App settings
DEFAULT_LOCALE="en"
TZ="Asia/Jerusalem"
LOG_LEVEL="info"

# Cron — shared secret for /api/cron/* endpoints. Required for unattended runs
# (system cron, Vercel cron). When unset, the bearer-token path is disabled
# and cron routes are reachable only via an authenticated admin session.
CRON_SECRET=""

# Feature flags (set to "true" to enable, default all false for safety)
# WARNING: Do NOT enable receipt_finalize until accountant has verified templates,
# numbering, VAT rate, and any applicable Tax Authority requirements.
RECEIPT_FINALIZE_ENABLED="false"
FINANCIAL_DOCUMENTS_MODULE="false"
AGENT_CONTROL_CENTER_MODULE="false"

# ===== Compliance gates =====
# Required for any production-issuance code path to run. Default UNSET
# (i.e. false). Set to "true" only on the production host after the real
# CPA and project owner have approved live issuance. Even with this set,
# the receipt_finalize_enabled feature flag AND the pdf_watermark_disabled
# flag must also be true for the watermark to lift.
ALLOW_PRODUCTION_ISSUANCE=

# ===== Billing email (Phase 4 Wave 2) =====
# Mirrors the receipts 3-gate lock for outbound email. Real client/admin
# email is transmitted ONLY when ALL THREE of the following hold:
#   1. feature flag `billing_email_real_send` = true (admin sets in /admin)
#   2. ALLOW_PRODUCTION_EMAIL = "true"            (this file, prod host only)
#   3. EMAIL_PROVIDER set to a non-empty token    (this file)
# If ANY is missing, the system is in TEST MODE: every email is written to the
# EmailLog table (testMode=true, status=queued) and NEVER transmitted.
#
# IMPORTANT: even with all three gates set, V2 still does not send. The
# transport seam (lib/email/transport.ts) is deliberately stubbed and throws on
# the real-send path; the EmailLog row is marked failed with reason
# "provider_not_wired". Wiring a real provider SDK is a separate, reviewed
# follow-up. Default both UNSET (i.e. test mode).
ALLOW_PRODUCTION_EMAIL=
# One of: resend | sendgrid | ses | smtp. Any non-empty value satisfies gate 3.
EMAIL_PROVIDER=
# Optional From address used on EmailLog rows when CompanySettings.email is
# unset. Falls back to a clearly-fake sentinel when both are empty.
EMAIL_FROM=
